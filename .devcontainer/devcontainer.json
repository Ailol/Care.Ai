{
    "name": "Dapr Services",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "runArgs": [
        "--name", "dapr-services",
        "-p", "6050:50005",
        "-p", "6060:50006"
    ],
    "overrideCommand": true,
    "postCreateCommand": "dapr init --slim",
    "postStartCommand": "placement --port 50005 & scheduler --port 50006",
    "forwardPorts": [50005, 50006]
}