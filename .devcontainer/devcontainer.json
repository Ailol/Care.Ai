{
    "name": "Care.AI Development Container",
    "image": "mcr.microsoft.com/devcontainers/dotnet:1-9.0",
    "features": {
        "ghcr.io/devcontainers/features/dotnet:2": {
            "version": "9.0"
        },
        "ghcr.io/devcontainers/features/azure-cli:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "forwardPorts": [5000, 5050, 15888],
    "portsAttributes": {
        "5000": {
            "label": "Care.AI API - Webhook Endpoint",
            "onAutoForward": "notify",
            "visibility": "public"
        },
        "5050": {
            "label": "MCP Gateway",
            "onAutoForward": "silent"
        },
        "15888": {
            "label": "Aspire Dashboard",
            "onAutoForward": "openBrowser"
        }
    },
    "postCreateCommand": "chmod +x ./build-packages.sh && ./build-packages.sh && dotnet restore",
    "postStartCommand": "echo 'Ready! Run: dotnet run --project src/Care.Ai.AppHost'",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "ms-dotnettools.csharp",
                "ms-azuretools.vscode-docker"
            ]
        },
        "codespaces": {
            "openFiles": [
                "README.md"
            ]
        }
    },
    "waitFor": "postCreateCommand"
}