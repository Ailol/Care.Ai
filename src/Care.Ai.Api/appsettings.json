{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "VectorStore": {
    "Provider": "PostgreSQL",
    "Url": "Host=localhost;Port=5432;Database=main_db;Username=user;Password=password"
  },
  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "Model": "qwen3-clean:latest"
  },
  "Ollama-embedding": {
    "Endpoint": "http://localhost:11435",
    "Model": "qwen3-embedding:0.6b"
  },
  "Ollama-ranker": {
    "Endpoint": "http://localhost:11434",
    "Model": "qwen2:0.5b"
  },
  "CareAi": {
    "Kernel": {
      "SmartRoutingProvider": "semantic-kernel",
      "SmartRoutingModel": "qwen3-clean:latest"
    },
    "ProviderRegistry": {
      "DiscoveryTimeoutSeconds": 5
    },
    "McpServers": {
      "azuredevops": {
        "type": "stdio",
        "command": "npx",
        "args": "-y @azure-devops/mcp ${ADO_ORG}",
        "exposeTo": ["semanticKernel", "llamaIndex", "chat"]
      },
      "github-sse": {
        "type": "sse",
        "endpoint": "http://github-mcp:3000/sse",
        "exposeTo": ["semanticKernel"]
      }
    }
  }
}
