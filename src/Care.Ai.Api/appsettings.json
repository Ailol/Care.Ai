{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "McpGateway": {
    "Url": "http://localhost:5050"
  },
  "CareAi": {
    "Kernel": {
      "SmartRoutingProvider": "semantic-kernel-provider",
      "SmartRoutingModel": "qwen3:0.6b",
      "EnableSmartRouting": false,
      "ManifestCacheDurationSeconds": 300,
      "ProviderPriorities": {
        "chat": "semantic-kernel-provider",
        "rag": "semantic-kernel-provider",
        "agent": "semantic-kernel-provider"
      }
    },
    "ProviderRegistry": {
      "KnownProviders": [
        "semantic-kernel-provider",
        "llamaindex-provider"
      ],
      "DiscoveryTimeoutSeconds": 5
    }
  }
}